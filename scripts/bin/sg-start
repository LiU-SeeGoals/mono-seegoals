#!/usr/bin/env python3

import os
import subprocess
import sys
import shutil

RED = "\033[1;31m"
GREEN = "\033[1;32m"
CYAN = "\033[1;36m"
NC = "\033[0m"

script_dir = os.path.dirname(os.path.abspath(__file__))
env_path = os.path.join(script_dir, "..", "..", "environment.ini")
docker_dir = os.path.join(script_dir, "..", "..", "docker")
software_dir = os.path.join(script_dir, "..", "..", "software")
ssl_vision_dir = os.path.join(software_dir, "ssl-vision")
vision_processor_dir = os.path.abspath(os.path.join(software_dir, "ssl-vision-processor"))
vision_processor_unit = "seegoals-vision-processor.service"

def read_env_ini():
    env_vars = {}
    with open(env_path, "r") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                key, value = line.split("=", 1)
                env_vars[key.strip()] = value.strip().strip('"').strip("'")
    return env_vars

envs = read_env_ini()

AI = envs.get("DOCKER_NAME_AI")
GW = envs.get("DOCKER_NAME_GAME_VIEWER")
VISION_CLIENT = envs.get("DOCKER_NAME_SSL_VISION_CLIENT")
GC = envs.get("DOCKER_NAME_SSL_GAME_CONTROLLER")
SIM = envs.get("DOCKER_NAME_SIM")
AUTOREF = envs.get("DOCKER_NAME_TIGER_AUTOREF")
VERBOSE = False

flags = {
    "rebuild": ["--rebuild"],
    "no-network": ["--no-network"],
    "vision-processor": ["--vision-processor"],
    "help": ["-h", "--help"],
    "verbose": ["-v", "--verbose"]
}

remove_containers = [AI, GW, VISION_CLIENT, GC, SIM, AUTOREF]
project_name = "seegoals"

choices = [
    {
        "choice-text": "Rebuild local images.",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-p", project_name, "build", "--no-cache"
        ],
        "container_to_enter": None,
    },
    {
        "choice-text": f"Develop on '{AI}' files, (auto-start '{GW}' program)",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.autostart_gameviewer.yml",
            "-p", project_name,
            "up", "-d"
        ],
        "container_to_enter": AI
    },
    {
        "choice-text": f"Develop on '{GW}' files (auto-start '{AI}' program).",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.autostart_ai.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": GW
    },
    {
        "choice-text": f"Develop on `{AI}` and '{GW}' files (auto-start nothing).",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": None
    },
    {
        "choice-text": f"Fetdatorn configuration",
        "pull_images": [],
        "pre_cmd": [ f"{ssl_vision_dir}/start.sh" ],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.fetdatorn.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": AI
    },
    {
        "choice-text": f"Fetdatorn configuration (+ autoref)",
        "pull_images": [],
        "pre_cmd": [ f"{ssl_vision_dir}/start.sh" ],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.fetdatorn.yml",
            "-f", f"{docker_dir}/docker-compose.autoref.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": AI
    },
    {
        "choice-text": "Start for competition.",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.competition.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": envs.get("DOCKER_NAME_AI")
    },
    {
        "choice-text": f"Develop on '{GW}' files, enter on startup.",
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.gameviewer.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": GW
    },
    {
        "choice-text": "Fetdatorn configuration (new vision processor + autoref)",
        "vision_processor": True,
        "pull_images": [],
        "pre_cmd": [],
        "docker_cmd": [
            "docker", "compose",
            "-f", f"{docker_dir}/docker-compose.yml",
            "-f", f"{docker_dir}/docker-compose.fetdatorn.yml",
            "-p", project_name, "up", "-d"
        ],
        "container_to_enter": AI
    }
]


def check_vision_processor():
    for command in ("systemd-run", "systemctl"):
        if shutil.which(command) is None:
            raise RuntimeError(f"The new vision option requires {command} (systemd user services).")
    subprocess.run(["systemctl", "--user", "show-environment"],
                   stdout=subprocess.DEVNULL, check=True)
    if subprocess.run(["pgrep", "-x", "vision"], stdout=subprocess.DEVNULL).returncode == 0:
        raise RuntimeError("Stop the old ssl-vision program before starting the new processor.")
    subprocess.run([sys.executable, f"{vision_processor_dir}/start.py", "--check"], check=True)


def stop_vision_processor():
    subprocess.run(["systemctl", "--user", "stop", vision_processor_unit],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def start_vision_processor():
    try:
        subprocess.run([
            "systemd-run", "--user", "--collect", f"--unit={vision_processor_unit}",
            "--property=Type=notify", "--property=TimeoutStartSec=30s",
            "--property=TimeoutStopSec=10s", f"--working-directory={vision_processor_dir}",
            "--", sys.executable, "-u", f"{vision_processor_dir}/start.py"
        ], check=True)
    except (OSError, subprocess.CalledProcessError, KeyboardInterrupt):
        stop_vision_processor()
        print(f"Vision startup failed. Logs: journalctl --user -u {vision_processor_unit} -n 80")
        raise
    print(f"Vision logs: journalctl --user -u {vision_processor_unit} -f")


def check_submodule_status():
    result = subprocess.run(["git", "submodule", "status"],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
    return b"^-" not in result.stdout


def remove_old_containers():
    print("Removing old containers:", file=sys.stderr)
    for container in remove_containers:
        print(f"\t{container}...")
        subprocess.run(["docker", "rm", container],
                       stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)


def execute_choice(choice, rebuild):
    print(f"Starting: {choices[choice]['choice-text']}")

    container_to_enter = None
    docker_cmd = choices[choice]["docker_cmd"].copy()
    docker_cmd[2:2] = ["--env-file", env_path]
    pre_cmd = choices[choice]["pre_cmd"]
    container_to_enter = choices[choice]["container_to_enter"]

    if rebuild and "up" in docker_cmd:
        docker_cmd += ["--build", "-d", "--force-recreate"]

    if network:
        for image in choices[choice]["pull_images"]:
            subprocess.run(["docker", "pull", image])

    if pre_cmd:
        if VERBOSE:
            print(f"Pre CMD: {' '.join(pre_cmd)}")
        subprocess.Popen(pre_cmd)

    if VERBOSE:
        print(f"Docker CMD: {' '.join(docker_cmd)}")

    use_vision_processor = choices[choice].get("vision_processor", False)
    if use_vision_processor:
        start_vision_processor()
    try:
        subprocess.run(docker_cmd, check=True)
    except (OSError, subprocess.CalledProcessError, KeyboardInterrupt):
        if use_vision_processor:
            stop_vision_processor()
        raise

    if choices[choice]["container_to_enter"] is not None:
        cmd = [
            "docker", "exec", "-it", container_to_enter,
            "sh", "-c", "exec bash"
        ]
        print(f"{CYAN}Entering {container_to_enter} container...{NC}")
        subprocess.run(cmd)


if __name__ == "__main__":
    choice = None
    rebuild = False
    network = True

    if any(arg in flags["help"] for arg in sys.argv[1:]):
        print("Usage: sg-start [CHOICE | --vision-processor] [--rebuild] [--no-network] [--verbose]")
        print("Without a choice, opens the configuration menu. Stop with sg-kill.")
        for index, config in enumerate(choices):
            print(f"{index}. {config['choice-text']}")
        sys.exit(0)

    docker_path = shutil.which("docker")
    if docker_path is None:
        print("You need to install docker...")
        sys.exit(1)

    result = subprocess.run(["docker", "ps"],
                            stderr=subprocess.PIPE,
                            stdout=subprocess.PIPE,
                            text=True)
    if result.returncode == 1:
        print(f"Couldn't run \"docker ps\":\n{result.stderr}")
        sys.exit(1)

    result = subprocess.run(["docker", "compose", "version"],
                            stderr=subprocess.DEVNULL,
                            stdout=subprocess.DEVNULL)
    if result.returncode == 1:
        print("You need to install docker compose...")
        sys.exit(1)

    # Parse options
    if len(sys.argv) > 1:
        if sys.argv[1].isdigit():
            choice = int(sys.argv[1])
            sys.argv.pop(1)

        for arg in sys.argv[1:]:
            if arg in flags["vision-processor"]:
                choice = next(i for i, config in enumerate(choices) if config.get("vision_processor"))
            if arg in flags["rebuild"]:
                print("Rebuilding containers...")
                rebuild = True
            if arg in flags["no-network"]:
                network = False
            if arg in flags["verbose"]:
                VERBOSE = True

    # Choose what to do
    if choice is None:
        print("Select Docker Compose configuration:")
        for i, choice in enumerate(choices):
            print(f"{i}. {choice['choice-text']}")

        choice = int(input(f"Enter your choice (0-{len(choices)-1}): "))

    if not (0 <= choice < len(choices)):
        print(f"Invalid choice {choice}...")
        sys.exit(1)

    # Check before sg-kill so missing dependencies leave the existing stack running.
    if choices[choice].get("vision_processor"):
        try:
            check_vision_processor()
        except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
            print(f"Cannot start the new vision processor: {error}", file=sys.stderr)
            sys.exit(1)

    # Enable x forwarding for docker containers.
    os.system("xhost +")

    # Update submodules
    if check_submodule_status():
        print("All submodules are already initialized.")
    else:
        print("Submodules are not initialized. Initializing now...")
        subprocess.run(["git", "submodule", "update", "--init", "--recursive", "--no-fetch", "--remote"])
        subprocess.run(["git", "status", "--ignore-submodules=all"])
        print("Submodules initialized and updated.")

    # Cleanup
    print(f"{CYAN}Killing previous containers...{NC}")
    subprocess.run([f"{script_dir}/sg-kill"], check=True)
    remove_old_containers()

    # Execute
    try:
        execute_choice(choice, rebuild)
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"Startup failed: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
